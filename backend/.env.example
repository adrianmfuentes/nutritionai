# Copy this file to .env (local dev) or .env.local, and fill in real values.
# cp .env.example .env

NODE_ENV=development
PORT=3000

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nutrition_ai
DB_USER=nutrition_user
DB_PASSWORD=

# --- Auth ---
# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# --- AI ---
# Photo-based meal analysis uses Google Gemini's vision model - get a key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Text-description analysis and the nutrition chat assistant use Groq (free,
# fast Llama inference) - get a key at https://console.groq.com
GROQ_API_KEY=

# --- CORS ---
# Comma-separated list of allowed origins, e.g. https://app.example.com
CORS_ORIGIN=

# --- Email (verification codes, weekly digest) ---
# Using Gmail: host is smtp.gmail.com, SMTP_USER is your full Gmail address,
# and SMTP_PASS must be a 16-character App Password (not your normal Gmail
# password) from https://myaccount.google.com/apppasswords. SMTP_FROM must
# match SMTP_USER (or a verified Gmail alias) or Gmail will reject the send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Uploads / logging ---
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
LOG_PATH=./logs
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Push notifications (optional) ---
# Base64-encoded Firebase service-account JSON. Leave empty to disable push
# notifications - the reminder job then just logs a warning and skips itself.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Cron schedules (UTC) for the scheduled jobs
DIGEST_CRON=0 9 * * 1
REMINDER_CRON=0 20 * * *
