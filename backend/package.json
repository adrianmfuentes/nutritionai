    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
